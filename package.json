{
  "name": "full-stack-estate",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev -C client\" \"npm run dev -C api\"",
    "install:client": "cd client && npm install",
    "install:api": "cd api && npm install",
    "install": "npm run install:client && npm run install:api",
    "build": "npm run build -C client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@clerk/backend": "^1.0.0",
    "@raruto/leaflet-gesture-handling": "^1.6.3"
  }
}
